# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/agritech_platform
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=agritech_super_secret_jwt_key_2024

# External APIs
WEATHER_API_KEY=your-weather-api-key
SMS_API_KEY=your-sms-service-key
UPI_MERCHANT_ID=your-upi-merchant-id

# AI Service
AI_SERVICE_URL=http://localhost:5001
OPENAI_API_KEY=your-openai-key (optional)

# File Storage
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Credit System Configuration
DEFAULT_CREDIT_BALANCE=0
COMPLAINT_RESOLUTION_CREDITS=10
URGENT_RESOLUTION_BONUS=15
FEEDBACK_BONUS_CREDITS=5